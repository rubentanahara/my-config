{
  "context": {
    "fileName": [
      "AGENTS.md"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "name": "session-start",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/agent/session-start.sh\" gemini",
            "timeout": 300000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "stop-gate",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/agent/stop-gate.sh\" gemini",
            "timeout": 300000
          }
        ]
      }
    ]
  }
}
