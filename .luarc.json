{
  "runtime.version": "LuaJIT",
  "diagnostics": {
    "globals": [
      "vim",
      "wezterm",
      "describe",
      "it",
      "before_each",
      "after_each",
      "assert"
    ]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "$VIMRUNTIME/lua",
      "$VIMRUNTIME/lua/vim/lsp",
      "${3rd}/luv/library"
    ],
    "ignoreDir": [
      ".git",
      "node_modules",
      "configstore",
      "yarn",
      "NuGet"
    ]
  },
  "completion": {
    "callSnippet": "Replace",
    "keywordSnippet": "Replace"
  }
}
