{
  "runtime.version": "LuaJIT",
  "diagnostics": {
    "globals": [
      "vim",
      "describe",
      "it",
      "before_each",
      "after_each",
      "assert"
    ]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "$VIMRUNTIME/lua",
      "$VIMRUNTIME/lua/vim/lsp",
      "${3rd}/luv/library"
    ]
  },
  "completion": {
    "autoRequire": true,
    "callSnippet": "Replace",
    "keywordSnippet": "Replace"
  }
}
